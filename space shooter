#include <iostream>
#include <conio.h>
#include <windows.h>
#include <vector>
using namespace std;

int x = 10, y = 9, score = 0;
bool gameOver = false;
struct Obj { int x, y; };
vector<Obj> bullets, asteroids;

void Draw() {
    system("cls");
    for (int i = 0; i < 22; i++) cout << "#";
    cout << endl;
    for (int i = 0; i < 10; i++) {
        for (int j = 0; j < 20; j++) {
            bool printed = false;
            if (j == x && i == y) { cout << "^"; printed = true; }
            for (int k = 0; k < bullets.size(); k++) {
                if (bullets[k].x == j && bullets[k].y == i) { cout << "|"; printed = true; }
            }
            for (int k = 0; k < asteroids.size(); k++) {
                if (asteroids[k].x == j && asteroids[k].y == i) { cout << "O"; printed = true; }
            }
            if (!printed) cout << " ";
        }
        cout << "#" << endl;
    }
    for (int i = 0; i < 22; i++) cout << "#";
    cout << "\nScore: " << score << endl;
}

void Input() {
    if (_kbhit()) {
        char ch = _getch();
        if (ch == 'a' && x > 0) x--;
        if (ch == 'd' && x < 19) x++;
        if (ch == 'w') bullets.push_back({x, y - 1});
        if (ch == 'x') gameOver = true;
    }
}

void Logic() {
    for (int i = 0; i < bullets.size(); i++) bullets[i].y--;
    for (int i = 0; i < bullets.size(); i++) {
        if (bullets[i].y < 0) bullets.erase(bullets.begin() + i);
    }

    if (rand() % 10 < 2) asteroids.push_back({rand() % 20, 0});
    for (int i = 0; i < asteroids.size(); i++) asteroids[i].y++;
    for (int i = 0; i < asteroids.size(); i++) {
        if (asteroids[i].y > 9) asteroids.erase(asteroids.begin() + i);
    }

    for (int i = 0; i < asteroids.size(); i++) {
        for (int j = 0; j < bullets.size(); j++) {
            if (asteroids[i].x == bullets[j].x && asteroids[i].y == bullets[j].y) {
                asteroids.erase(asteroids.begin() + i);
                bullets.erase(bullets.begin() + j);
                score++;
                break;
            }
        }
    }

    for (int i = 0; i < asteroids.size(); i++) {
        if (asteroids[i].x == x && asteroids[i].y == y) gameOver = true;
    }
}

int main() {
    while (!gameOver) {
        Draw();
        Input();
        Logic();
        Sleep(100);
    }
    cout << "Game Over! Final Score: " << score << endl;
    return 0;
